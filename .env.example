# Leaf Blog runtime (Node.js + SQLite)
NODE_ENV=production
HOST=127.0.0.1
PORT=8080

# Nginx 反向代理后启用，直接暴露 Node 时保持 false/不填
# TRUST_PROXY=true

# Shared runtime state (sessions, rate limits, cooldowns, OTP challenges)
# Keep empty for single-process development; set this on production servers.
# REDIS_URL=redis://127.0.0.1:6379

# Automatic data backup
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=7
# For production, prefer a directory outside the web/project root.
# BACKUP_DIR=/var/backups/leaf-blog

# SQLite 数据库路径；默认：./data/leaf-blog.db
# DB_PATH=./data/leaf-blog.db

# 每日热点：服务器按上海时间每天自动刷新，默认每天 07:00。
HOT_TOPICS_ENABLED=true
# 每个分类最多保留多少条，默认每类 10 条。
HOT_TOPICS_LIMIT=10
HOT_TOPICS_REFRESH_HOUR=7
HOT_TOPICS_REFRESH_MINUTE=0
# 外部来源暂时失败时，多久后允许再次尝试（分钟）。
HOT_TOPICS_RETRY_MINUTES=30
# 可选：GitHub API Token，只需要公开仓库的 Metadata 读取权限；不填也能工作，但匿名额度较低。
# GITHUB_TOKEN=
# 可选：用英文逗号分隔多个来源；格式为 分类|URL，留空使用内置四类来源。
# 分类可用：tech、game、github、entertainment。
# HOT_TOPICS_FEEDS=game|https://example.com/game.xml,tech|https://example.com/tech.xml
# 英文热点标题自动翻译为中文；外部翻译服务不可用时保留原文。
HOT_TOPICS_TRANSLATION_ENABLED=true
# HOT_TOPICS_TRANSLATION_MAX_ITEMS=40

# Optional comma-separated domains to reject in external resources and friend links.
# LINK_BLOCKLIST=bad.example,phishing.example

# 阅读量去重窗口（分钟，默认 30；范围 5-1440）
# VIEW_DEDUP_MINUTES=30

# Use a long, unique administrator password.
ADMIN_PASSWORD=change_to_a_long_random_password
# The QQ account local-part that is allowed to open /admin (do not use a display name).
ADMIN_ACCOUNT=your_qq_account

# QQ Mail SMTP
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_qq_email@qq.com
SMTP_PASS=your_qq_smtp_authorization_code
SMTP_FROM=your_qq_email@qq.com

# One-time password settings
OTP_TTL_MINUTES=5
OTP_HASH_SECRET=change_to_at_least_32_random_characters
OTP_EMAIL_DAILY_LIMIT=10
OTP_IP_DAILY_LIMIT=10
OTP_GLOBAL_DAILY_LIMIT=500

# CAPTCHA integration is intentionally disabled until a provider is selected.
# CAPTCHA_ENABLED=false
# CAPTCHA_VERIFY_URL=
# CAPTCHA_SECRET=
